# lpix container environment variables
# Copy to .env and fill in values before running docker compose up

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Shared secret between Hermes and the lpix container.
# Generate with: openssl rand -hex 32
LPIX_API_KEY=change-me-generate-with-openssl-rand-hex-32


# ── HERMES SIDE (add these to your Hermes .env) ───────────────────────────────

# URL that Hermes uses to reach the lpix container.
# If using docker-compose with a shared network: http://lpix:8080
# If exposing to host only: http://localhost:8080
LPIX_URL=http://lpix:8080

# Same value as LPIX_API_KEY above
# LPIX_API_KEY=change-me-generate-with-openssl-rand-hex-32


# ── OPTIONAL ──────────────────────────────────────────────────────────────────

# Launchpad project to auto-sync when container starts.
# Leave unset to skip auto-sync (trigger manually via POST /sync).
# LP_AUTO_SYNC_PROJECT=ubuntu
# LP_AUTO_SYNC_LIMIT=500

# Override the port (default 8080)
# PORT=8080
